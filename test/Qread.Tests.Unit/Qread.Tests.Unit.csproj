<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup>
    <TestingPlatformCommandLineArguments>--crashdump --hangdump</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.6.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.2.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.2.1" />
    <PackageReference Include="TUnit" Version="1.40.10" />
    <PackageReference Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageReference Include="Verify.TUnit" Version="31.16.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qread\Qread.csproj" />
  </ItemGroup>
</Project>
