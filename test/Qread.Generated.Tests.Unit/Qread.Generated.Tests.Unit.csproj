<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup>
    <TestingPlatformCommandLineArguments>--crashdump --hangdump</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Imposter" Version="0.1.9" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.2.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.2.1" />
    <PackageReference Include="TUnit" Version="1.40.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Imposter.Abstractions" />
    <Using Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\src\Qread.Attributes\Qread.Attributes.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference
      Include="..\..\src\Qread\Qread.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
    />
  </ItemGroup>
</Project>
